# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Secrets & environment
.env
.env.*
!.env.example
*.pem
*.key

# Raw & heavy data artifacts (keep splits/ and small CSVs tracked)
data/raw/*
!data/raw/.gitkeep
data/processed/slices/
data/processed/*.npy
data/processed/*.npz
*.nii
*.nii.gz
*.dcm

# Model weights & run artifacts
outputs/checkpoints/*
!outputs/checkpoints/.gitkeep
outputs/logs/*
!outputs/logs/.gitkeep
*.pt
*.pth
*.ckpt
*.safetensors
*.h5
*.hdf5

# External reference repos (cloned on approval)
external/*
!external/.gitkeep

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
